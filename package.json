{
  "name": "eva-mcp",
  "version": "0.8.1",
  "description": "MCP server for EvaProject — task management, sprints, requirements, worklog, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eva-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schebotar/eva-mcp.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit && npm run build && node scripts/check-tools.mjs && node scripts/check-credentials.mjs",
    "smoke": "npm run build && node scripts/smoke-mcp.mjs",
    "probe": "npm run build && node scripts/mcp-probe.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "evaproject",
    "evateam"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "marked": "^18.0.6",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
